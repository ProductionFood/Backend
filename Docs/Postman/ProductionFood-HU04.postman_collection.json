      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/api/v1/bitacora?fechaInicio=2026-12-31&fechaFin=2026-01-01",
       "host": ["{{baseUrl}}"],
       "path": ["api", "v1", "bitacora"],

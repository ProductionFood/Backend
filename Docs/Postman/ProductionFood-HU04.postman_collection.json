  },
  {
   "name": "HU-04 · Autorización",
   "description": "CA-04: solo ADMIN y solo lectura",
   "item": [
    {
     "name": "Sin token → 401 NO_AUTENTICADO",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/api/v1/bitacora",
       "host": ["{{baseUrl}}"],
       "path": ["api", "v1", "bitacora"]
      },
      "header": []
     },
     "event": [
      {
       "listen": "test",
       "script": {
       "type": "text/javascript",
       "exec": [
        "pm.test(\"→ 401\", () => pm.response.to.have.status(401));",
        "pm.test(\"code NO_AUTENTICADO\", () =>",
        "  pm.expect(pm.response.json().code).to.eql(\"NO_AUTENTICADO\"));"
       ]
      }
      }
     ]
    },
    {
     "name": "Rol VENTAS → 403 SIN_PERMISO",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/api/v1/bitacora",
       "host": ["{{baseUrl}}"],
       "path": ["api", "v1", "bitacora"]
      },
      "header": [{ "key": "Authorization", "value": "Bearer {{tokenVentas}}" }]
     },
     "event": [
      {
       "listen": "prerequest",
       "script": {
       "type": "text/javascript",
       "exec": [
        "var correo = \"ventas-\" + Date.now() + \"@productionfood.local\";",
        "pm.collectionVariables.set(\"correoVentas\", correo);",
        "pm.sendRequest({",
        "  url: pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/usuarios\",",
        "  method: \"POST\",",
        "  header: { \"Authorization\": \"Bearer \" + pm.collectionVariables.get(\"token\"), \"Content-Type\": \"application/json\" },",
        "  body: { mode: \"raw\", raw: JSON.stringify({ nombre: \"Ventas HU04\", correo: correo, password: \"Clave2026*\", idRol: 4 }) }",
        "}, function (err, res) {",
        "  pm.sendRequest({",
        "    url: pm.collectionVariables.get(\"baseUrl\") + \"/api/v1/auth/login\",",
        "    method: \"POST\",",
        "    header: { \"Content-Type\": \"application/json\" },",
        "    body: { mode: \"raw\", raw: JSON.stringify({ correo: correo, password: \"Clave2026*\" }) }",
        "  }, function (err2, res2) {",
        "    pm.collectionVariables.set(\"tokenVentas\", res2.json().token);",
        "  });",
        "});"
       ]
      }
      },
      {
       "listen": "test",
       "script": {
       "type": "text/javascript",
       "exec": [
        "pm.test(\"→ 403\", () => pm.response.to.have.status(403));",
        "pm.test(\"code SIN_PERMISO\", () =>",
        "  pm.expect(pm.response.json().code).to.eql(\"SIN_PERMISO\"));"
       ]
      }
      }
     ]
    },
    {
     "name": "POST /bitacora → 405 (solo lectura)",
     "request": {
      "method": "POST",
      "url": {
       "raw": "{{baseUrl}}/api/v1/bitacora",
       "host": ["{{baseUrl}}"],
       "path": ["api", "v1", "bitacora"]
      },
      "header": [
       { "key": "Authorization", "value": "Bearer {{token}}" },
       { "key": "Content-Type", "value": "application/json" }
      ],
      "body": { "mode": "raw", "raw": "{}" }
     },
     "event": [
      {
       "listen": "test",
       "script": {
       "type": "text/javascript",
       "exec": [
        "pm.test(\"→ 405\", () => pm.response.to.have.status(405));",
        "pm.test(\"code METODO_NO_PERMITIDO\", () =>",
        "  pm.expect(pm.response.json().code).to.eql(\"METODO_NO_PERMITIDO\"));"
       ]
      }
      }
     ]
    },
    {
     "name": "DELETE /bitacora/1 → 405 (solo lectura)",
     "request": {
      "method": "DELETE",
      "url": {
       "raw": "{{baseUrl}}/api/v1/bitacora/1",
       "host": ["{{baseUrl}}"],
       "path": ["api", "v1", "bitacora", "1"]
      },
      "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
     },
     "event": [
      {
       "listen": "test",
       "script": {
       "type": "text/javascript",
       "exec": [
        "pm.test(\"→ 404 o 405: nunca 200\", () =>",
        "  pm.expect(pm.response.code).to.be.oneOf([404, 405]));"
       ]
      }
      }
     ]
    }
   ]
  }
 ],

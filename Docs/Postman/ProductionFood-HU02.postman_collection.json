    {
     "name": "Crear usuario para editar → 201",
     "request": {
      "method": "POST",
      "url": {
       "raw": "{{baseUrl}}/api/v1/usuarios",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "v1",

       ]
      },
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "description": "El contrato acota size a 1..100; por encima responde 400, no recorta"
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"→ 400\", () => pm.response.to.have.status(400));",
         "var json = pm.response.json();",
         "pm.test(\"code PARAMETRO_INVALIDO\", () => pm.expect(json.code).to.eql(\"PARAMETRO_INVALIDO\"));",
         "pm.test(\"El mensaje menciona el tope\", () => pm.expect(json.message).to.contain(\"100\"));"
        ]
       }
      }
     ]
    },
    {
     "name": "page=-1 → 400 PARAMETRO_INVALIDO",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/api/v1/usuarios?page=-1",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "v1",
        "usuarios"
       ],
       "query": [
        {
         "key": "page",
         "value": "-1"
        }
       ]
      },
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "description": "page negativo responde 400 en vez de recortarse a 0"
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"→ 400\", () => pm.response.to.have.status(400));",
         "pm.test(\"code PARAMETRO_INVALIDO\", () => pm.expect(pm.response.json().code).to.eql(\"PARAMETRO_INVALIDO\"));"
        ]
       }
      }
     ]
    },
    {
     "name": "Obtener usuario por id → 200",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "v1",
        "usuarios",
        "{{usuarioId}}"
       ]
      },
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "description": "CA-02: el id sale del listado (variable usuarioId)"
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"→ 200\", () => pm.response.to.have.status(200));",
         "var json = pm.response.json();",
         "pm.test(\"Trae id, nombre, correo, activo y rol\", () => {",
         "  pm.expect(json).to.have.property(\"idUsuario\");",
         "  pm.expect(json).to.have.property(\"nombre\").that.is.a(\"string\");",
         "  pm.expect(json).to.have.property(\"correo\").that.is.a(\"string\");",
         "  pm.expect(json).to.have.property(\"activo\").that.is.a(\"boolean\");",
         "  pm.expect(json).to.have.property(\"rol\").with.property(\"nombre\").that.is.a(\"string\");",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "Obtener usuario inexistente → 404",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/api/v1/usuarios/99999",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "v1",
        "usuarios",
        "99999"
       ]
      },
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "description": "Id que no existe responde 404 con mensaje de dominio"
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"→ 404\", () => pm.response.to.have.status(404));",
         "var json = pm.response.json();",
         "pm.test(\"code RECURSO_NO_ENCONTRADO\", () => pm.expect(json.code).to.eql(\"RECURSO_NO_ENCONTRADO\"));",
         "pm.test(\"Menciona el id\", () => pm.expect(json.message).to.contain(\"99999\"));"
        ]
       }
      }
     ]
    },
    {
     "name": "Obtener con id no numérico → 400",
     "request": {
      "method": "GET",

       "path": [
        "api",
        "v1",
        "usuarios",
        "{{editarId}}"
       ]
      },
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "description": "Relee de la base: los cambios del PUT persisten y el estado no cambió"
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"→ 200\", () => pm.response.to.have.status(200));",
         "var json = pm.response.json();",
         "pm.test(\"Persiste nombre y rol, sigue activo\", () => {",
         "  pm.expect(json.nombre).to.eql(\"Usuario Editado\");",
         "  pm.expect(json.rol.idRol).to.eql(2);",
         "  pm.expect(json.activo).to.eql(true);",
         "});",
         "pm.test(\"Nunca expone password\", () =>",
         "  pm.expect(json).to.not.have.property(\"password\"));"
        ]
       }
      }
     ]

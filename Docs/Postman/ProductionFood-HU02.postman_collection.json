       ]
      },
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "description": "Pre-requisito del folder: crea la víctima de edición con rol VENTAS y correo único por corrida",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"nombre\": \"Usuario Para Editar\",\n  \"correo\": \"{{editarCorreo}}\",\n  \"password\": \"Clave2026*\",\n  \"idRol\": 4\n}"
      }
     },
     "response": [],
     "event": [
      {
       "listen": "prerequest",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.collectionVariables.set(\"editarCorreo\", \"editar-\" + Date.now() + \"@productionfood.local\");"
        ]
       }
      },
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"Crear → 201\", () => pm.response.to.have.status(201));",
         "var json = pm.response.json();",
         "pm.collectionVariables.set(\"editarId\", json.idUsuario);",
         "pm.test(\"Queda activo con rol 4\", () => {",
         "  pm.expect(json.activo).to.eql(true);",
         "  pm.expect(json.rol.idRol).to.eql(4);",
         "});"
        ]
       }
      }
     ]
    },
    {
     "name": "PUT editar nombre y rol (mismo correo, campos extra) → 200",
     "request": {
      "method": "PUT",
      "url": {
       "raw": "{{baseUrl}}/api/v1/usuarios/{{editarId}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "api",
        "v1",
        "usuarios",
        "{{editarId}}"
       ]
      },
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       },
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "description": "CP-09 (cambios válidos), CP-10 (mismo correo no es duplicado) y CP-12 (password y activa llegan en el cuerpo pero se ignoran: no existen en el DTO)",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"nombre\": \"Usuario Editado\",\n  \"correo\": \"{{editarCorreo}}\",\n  \"idRol\": 2,\n  \"password\": \"NuevaClave123*\",\n  \"activo\": false\n}"
      }
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"PUT → 200\", () => pm.response.to.have.status(200));",
         "var json = pm.response.json();",
         "pm.test(\"Nombre y rol cambiaron\", () => {",
         "  pm.expect(json.nombre).to.eql(\"Usuario Editado\");",
         "  pm.expect(json.rol.idRol).to.eql(2);",
         "});",
         "pm.test(\"activo sigue en true: el campo extra se ignoró (CP-12)\", () =>",
         "  pm.expect(json.activo).to.eql(true));"
        ]
       }
      }
     ]
    },
    {
     "name": "GET verificar persistencia del PUT → 200",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{baseUrl}}/api/v1/usuarios/{{editarId}}",
       "host": [
        "{{baseUrl}}"

                "exec": [
                  "pm.test(\"→ 201\", () => pm.response.to.have.status(201));",
                  "var j = pm.response.json();",
                  "pm.collectionVariables.set(\"idProveedor\", j.idProveedor);",
                  "pm.test(\"activo true y resto null\", () => { pm.expect(j.activo).to.eql(true); pm.expect(j.contacto).to.eql(null); pm.expect(j.telefono).to.eql(null); pm.expect(j.correo).to.eql(null); });",
                  "pm.test(\"Location presente\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/v1/proveedores/\"));"
                ]
              }
            }

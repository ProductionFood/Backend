         "var json = pm.response.json();",
         "pm.test(\"code CREDENCIALES_INVALIDAS (no USUARIO_INACTIVO)\", () =>",
         "  pm.expect(json.code).to.eql(\"CREDENCIALES_INVALIDAS\"));",
         "pm.test(\"Coincide con el mensaje genérico\", () =>",
         "  pm.expect(json.message).to.eql(pm.collectionVariables.get(\"msgPassErr\")));"
        ]
       }
      }
     ]
    },
    {
     "name": "Token del desactivado en /perfil → 403 USUARIO_INACTIVO (SEC-05)",
     "request": {

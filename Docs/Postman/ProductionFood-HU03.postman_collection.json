        "api",
        "v1",
        "auth",
        "perfil"
       ]
      },
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{token}}"
       }
      ],
      "description": "CP-16: devuelve los mismos datos que devuelve usuario en el login",
      "body": {
       "mode": "raw",
       "raw": ""
      }
     },
     "response": [],
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test(\"→ 200\", () => pm.response.to.have.status(200));",
         "var json = pm.response.json();",
         "pm.test(\"Misma forma que PerfilResponse\", () => {",
         "  pm.expect(json).to.have.property(\"idUsuario\").that.is.a(\"number\");",
         "  pm.expect(json).to.have.property(\"nombre\").that.is.a(\"string\");",

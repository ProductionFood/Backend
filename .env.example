# Plantilla de configuracion local. Copiala como .env y ajusta los valores.
# Tanto docker-compose como el backend (springboot4-dotenv) leen este archivo.
#
# IMPORTANTE: guarda el .env como UTF-8 SIN BOM y con saltos de linea LF.
# Un BOM invisible al inicio hace que la primera variable se ignore en silencio.

# Conexion a la base de datos
# Usa 127.0.0.1 en lugar de localhost: en Windows "localhost" puede resolverse a
# IPv6 (::1) y Docker Desktop no siempre publica el puerto en IPv6.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=productionfood
DB_USER=root
DB_PASSWORD=local

# Secreto para firmar los JWT. Genera uno propio:
#   Linux/macOS:  openssl rand -base64 48
#   PowerShell:   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
